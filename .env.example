# Azure Document Intelligence (Form Recognizer) API Credentials
# Resource: ipqcdoc1234 | API Kind: FormRecognizer | Location: West Central US
REACT_APP_AZURE_DI_KEY=your_azure_di_key_here
REACT_APP_AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# Legacy Azure Computer Vision (same resource)
REACT_APP_AZURE_CV_KEY=your_azure_cv_key_here
REACT_APP_AZURE_CV_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# LLM Parser API Keys
REACT_APP_DEEPINFRA_API_KEY=your_deepinfra_key_here
# REACT_APP_TOGETHER_API_KEY=
# REACT_APP_GROQ_API_KEY=
# REACT_APP_GEMINI_API_KEY=
# REACT_APP_HUGGINGFACE_API_KEY=

# Backend API URL (production uses same origin)
REACT_APP_API_URL=/api
